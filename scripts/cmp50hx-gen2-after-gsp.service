# Offline artifact only — do not install on ai100gb without separate approval.
# This starts after NVIDIA has initialized GSP and before inference workloads.
[Unit]
Description=CMP50HX bounded Gen2 retrain after first NVIDIA GSP init
Wants=nvidia-persistenced.service
After=systemd-udev-settle.service nvidia-persistenced.service
Before=llama-qwen.service llama-ornith.service
ConditionPathExists=/usr/bin/nvidia-smi
ConditionPathExists=/usr/bin/setpci

[Service]
Type=oneshot
Environment=CMP50_GEN2_APPLY=1
Environment=CMP50_GEN2_READY_TIMEOUT_SEC=90
Environment=CMP50_GEN2_MAX_ATTEMPTS=3
ExecStart=/usr/local/sbin/cmp50hx-gen2-after-gsp.sh
TimeoutStartSec=140
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
